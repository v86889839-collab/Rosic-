// Главный файл Росич — main.рос
пусть имя = "Росич"
пусть версия: число = 1.0

функция приветствие(имя: текст) {
    печатать("Привет от " + имя)
}

приветствие(имя)

// Функция
функция квадрат(x) {
    вернуть x * x
}
печатать("Квадрат 5 = " + к_тексту(квадрат(5)))

// Условие
пусть n = 15
если (n > 10) {
    печатать("Больше десяти")
} иначе {
    печатать("Меньше десяти")
}

// Цикл для
для (пусть i в [1, 2, 3]) {
    печатать("Итерация " + к_тексту(i))
}

// Цикл пока
пусть c = 0
пока (c < 3) {
    печатать("Пока " + к_тексту(c))
    c = c + 1
}

// Бесконечный цикл со стопом
пусть r = 0
снова {
    r = r + 1
    печатать("Повтор " + к_тексту(r))
    если (r == 3) {
        стоп
    }
}

// Структура
структура Точка {
    х: число
    у: число
    функция сумма() {
        вернуть сам.х + сам.у
    }
}

пусть p = Точка { х: 15, у: 15 }
печатать("Сумма точки = " + к_тексту(p.сумма()))

печатать("Росич работает!")
